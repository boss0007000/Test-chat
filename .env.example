# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Sensor Configuration
CAMERA_ENABLED=true
ULTRASONIC_ENABLED=true
LIDAR_ENABLED=true

# Camera Settings
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Ultrasonic Settings
ULTRASONIC_MAX_DISTANCE=400.0
ULTRASONIC_SENSORS_COUNT=4

# Lidar Settings
LIDAR_MAX_RANGE=10.0
LIDAR_SCAN_RATE=10

# Robot Settings
SIMULATION_MODE=true
DEBUG_MODE=false
